# ── 采集数据（保留关键数据）────────────────────────────────
# 主日志以 .jsonl 格式为准（detection_log.json 旧格式已废弃）

# 本机坐标配置（随屏幕/浏览器位置变化，不入库；用 config.example.json 了解字段结构）
data/config.json
data/config_fwxx.json

# 忽略中间缓存（不需要上传）
data/patent_cache.json
data/patent_fwxx_cache.json
data/current_fwxx_target.json
data/fwxx_list.txt
data/failed_applications.txt
data/search_list_retry.txt
data/search_list.txt
data/raw_responses/
data/raw_searches/

# 运行时临时标志（不入库）
data/force_update.flag
data/login_ready.flag

# SQLite 数据库（主存储，二进制，不入库；用 detection_log.jsonl 作为 git 可追踪备份）
data/patents.db
data/patents.db-wal
data/patents.db-shm

# 配置备份（临时产物，不入库）
data/config_backup_*.json

# Excel 导出（衍生产物，可从 detection_log.jsonl 重新生成）
data/results/*.xlsx

# ── 浏览器驱动（二进制，不入库）──────────────────────────
chromedriver-win64/
chromedriver-linux64/

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/

# ── 登录凭证（绝对不入库）────────────────────────────────
.env

# ── Claude Code 本地配置 ─────────────────────────────────
.claude/

# ── 系统文件 ─────────────────────────────────────────────
.DS_Store
Thumbs.db
