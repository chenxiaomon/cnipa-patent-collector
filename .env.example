# 复制此文件为 .env，填入真实账号密码
# cp .env.example .env

CNIPA_USERNAME=
CNIPA_PASSWORD=

# 登录后等待验证码的秒数（无人值守时设长一点，如 90）
CNIPA_LOGIN_WAIT_SECONDS=75

# MITM 代理端口（默认 8083，通常不需要修改）
MITM_PORT=8083

# 无人值守看门狗
WATCHDOG_HEARTBEAT_TIMEOUT_SECONDS=600
WATCHDOG_MAX_RESTARTS=3
WATCHDOG_FAILURE_THRESHOLD=20
WATCHDOG_MIN_FREE_GB=5

# 开发机报警转发（Server酱）
# CNIPA_MASTER_URL 填部署机（master）的 Dashboard 地址，如 http://192.168.1.10:8765
CNIPA_MASTER_URL=
SERVERCHAN_SENDKEY=
ALERT_POLL_SECONDS=60
